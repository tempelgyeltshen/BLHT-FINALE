# Docker Compose Environment Variables
# Copy this file to docker-compose.env and fill in actual values
# IMPORTANT: Never commit docker-compose.env with real credentials to git

# MongoDB Configuration
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=CHANGE_THIS_SECURE_PASSWORD
MONGO_INITDB_DATABASE=blht

# Backend Configuration
NODE_ENV=production
PORT=4000
FRONTEND_ORIGIN=http://localhost

# JWT Secrets (Generate 32-byte random secrets)
JWT_ACCESS_SECRET=CHANGE_THIS_TO_32_BYTE_RANDOM_SECRET
JWT_REFRESH_SECRET=CHANGE_THIS_TO_DIFFERENT_32_BYTE_RANDOM_SECRET

# Admin Credentials
# ADMIN_EMAIL is also the inbox that receives new website inquiry notifications.
ADMIN_EMAIL=tempelgyeltshen12345@gmail.com
ADMIN_PASSWORD_HASH=CHANGE_THIS_TO_BCRYPT_HASH_OF_ADMIN_PASSWORD

# Email Notifications (inquiry form -> admin inbox)
# Recommended: Resend (https://resend.com) — set your API key to actually deliver
# the inquiry emails. Without a key, emails fall back to the webhook below, then
# to the server console (dev mode).
RESEND_API_KEY=
EMAIL_FROM=Inquiries <onboarding@resend.dev>
# Alternative transport: any webhook that receives the email payload as JSON.
# EMAIL_WEBHOOK_URL=https://hooks.zapier.com/...

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=YOUR_CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_API_SECRET

# MongoDB URI (internal network connection)
MONGODB_URI=mongodb://admin:CHANGE_THIS_SECURE_PASSWORD@mongodb:27017/blht?authSource=admin