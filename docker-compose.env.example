# Docker Compose Environment Variables
# Copy this file to docker-compose.env and fill in actual values
# IMPORTANT: Never commit docker-compose.env with real credentials to git

# MongoDB Configuration
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=CHANGE_THIS_SECURE_PASSWORD
MONGO_INITDB_DATABASE=blht

# Backend Configuration
NODE_ENV=production
PORT=4000
FRONTEND_ORIGIN=http://localhost

# JWT Secrets (Generate 32-byte random secrets)
JWT_ACCESS_SECRET=CHANGE_THIS_TO_32_BYTE_RANDOM_SECRET
JWT_REFRESH_SECRET=CHANGE_THIS_TO_DIFFERENT_32_BYTE_RANDOM_SECRET

# Admin Credentials
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD_HASH=CHANGE_THIS_TO_BCRYPT_HASH_OF_ADMIN_PASSWORD

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=YOUR_CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_API_SECRET

# MongoDB URI (internal network connection)
MONGODB_URI=mongodb://admin:CHANGE_THIS_SECURE_PASSWORD@mongodb:27017/blht?authSource=admin